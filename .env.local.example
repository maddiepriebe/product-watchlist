# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). These two are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used only by `pnpm gen:types` (Supabase CLI) to regenerate
# lib/supabase/database.types.ts. Not read by the app at runtime.
SUPABASE_PROJECT_ID=your-project-ref

# Price checker (the Python worker). SERVER-ONLY: read in Server Actions via
# lib/worker.ts. Never prefix these with NEXT_PUBLIC_ — the secret would ship
# to the browser. The secret must match the worker's WORKER_SHARED_SECRET.
WORKER_URL=http://localhost:8080
WORKER_SHARED_SECRET=change-me-to-a-long-random-string

# NOTE: the service-role key is intentionally absent. It is worker-only and
# must never live in the Next.js app or in this file.
