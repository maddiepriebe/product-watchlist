# Copy to worker/.env for local runs (`uv run --env-file .env …`).
# Never commit .env. On Fly these are secrets: `fly secrets set NAME=value`.

# --- required by the scheduler ---------------------------------------------
# Supabase -> Project Settings -> Database -> Connection string. Use the
# Session pooler (port 5432) or the direct connection, NOT the transaction
# pooler on 6543: the scheduler holds long-lived connections. This is the
# postgres role, which bypasses RLS, so it lives only here.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
RESEND_API_KEY=re_xxxxxxxx
# Must be on a domain verified in Resend.
ALERT_FROM_EMAIL="Watchlist <alerts@example.com>"
# Base URL of the Next.js app, for links in alert emails. No trailing slash.
APP_URL=http://localhost:3000

# --- required by the web API -------------------------------------------------
# Shared with the Next.js app (server-side only). Generate: openssl rand -hex 32
WORKER_SHARED_SECRET=change-me

# --- optional ----------------------------------------------------------------
PORT=8080
LOG_LEVEL=INFO
# WORKER_BATCH_SIZE=20
# WORKER_CONCURRENCY=8
# WORKER_LEASE_MINS=15
# WORKER_IDLE_SLEEP_S=30
# WORKER_DB_POOL_SIZE=4
# FETCH_DOMAIN_DELAY_S=2.0
# FETCH_DOMAIN_JITTER_S=1.5
# FETCH_TIMEOUT_S=20

# --- tests only --------------------------------------------------------------
# A Postgres 15+ server where tests may create and drop databases.
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:55450/postgres
